# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_DB=litellm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# Langfuse Database (will be created automatically)
LANGFUSE_DB=langfuse

# LiteLLM Database (will be created automatically)
LITELLM_DB=litellm

# =============================================================================
# LiteLLM Configuration
# =============================================================================
# Master key for admin access to LiteLLM
LITELLM_MASTER_KEY=sk-1234-change-this-master-key

# Salt key for encryption
LITELLM_SALT_KEY=sk-salt-1234-change-this-salt

# UI Credentials
UI_USERNAME=admin
UI_PASSWORD=change-me-admin-password

# =============================================================================
# LLM Providers API Keys
# =============================================================================
# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key - Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# Langfuse Configuration
# =============================================================================
# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-min-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# Salt for Langfuse
SALT=your-langfuse-salt-min-32-characters-long

# Telemetry (set to false for privacy)
TELEMETRY_ENABLED=false

# Langfuse API Keys (will be generated in the UI)
# After first login, create a project and copy these keys from Langfuse UI
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_PORT=8080
LOG_LEVEL=info

# =============================================================================
# Open WebUI Configuration (ChatGPT-like Interface)
# =============================================================================
# Virtual Key to use with Open WebUI (use one of the created keys)
# Default: MCP Users key (has access to GPT-4 and Claude)
OPEN_WEBUI_API_KEY=sk-eNrZudXmjoUNKo0O-ZaeJA

# Secret key for Open WebUI session management
WEBUI_SECRET_KEY=your-webui-secret-key-change-this

# =============================================================================
# Network Configuration
# =============================================================================
# Ports (default values, change if needed)
# PostgreSQL: 5432
# Langfuse: 3000
# LiteLLM: 4000
# MCP Server: 8080
# Open WebUI: 8888
